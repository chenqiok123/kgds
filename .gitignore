# 密钥
.env

# 运行时（本地数据库、Python 缓存）
kgds.db
*.pyc
__pycache__/

# 归档（V1/V2 旧架构 + 遗留 + 其他项目，确认后可整体删除）
/_archive/

# 数据（用户数据、自动备份不入库）
/data/users/
/data/backups/
/data/cache/
/data/roles/insurance-agent/.flywheel_last_run
*.bak_*

# 临时/生成文件（仅根目录，避免误伤 src/test_engine.py 等核心模块）
/_*.py
/_*.gz
/*.log
/fix_*.py
/test_*.py
/screenshot_*.png

# 部署平台文件
/zeabur.json
